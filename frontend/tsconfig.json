{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Vite injects import.meta.env; without this, VITE_* reads are untyped.
    "types": ["vite/client"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // esbuild transpiles per-file, so reject anything that needs cross-file type info.
    "isolatedModules": true,
    // Vite owns the build; tsc is a type checker only.
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
